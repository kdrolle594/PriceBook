# Copy to .env.local and fill in from your Supabase project
# (Project Settings -> API). These are safe to expose in the client —
# row-level security is what protects the data.
VITE_SUPABASE_URL=https://your-project.supabase.co
# Either the legacy "anon" key or the newer sb_publishable_… key works;
# name the variable to match which one you copied.
VITE_SUPABASE_ANON_KEY=your-anon-key
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
